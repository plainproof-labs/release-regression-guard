{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Release Regression Guard",
          "version": "1.1.0",
          "rules": [
            {
              "id": "metadata:name:description",
              "shortDescription": {
                "text": "Release check: metadata:name:description"
              },
              "helpUri": "https://html.spec.whatwg.org/multipage/",
              "properties": {
                "source": "html-elements"
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "release-regression-guard/"
      },
      "results": [
        {
          "ruleId": "metadata:name:description",
          "level": "note",
          "message": {
            "text": "/exception: name:description is missing or blank; accepted until 2026-12-31: Known migration gap with an owner"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fixtures/manifests/exception.json"
                }
              }
            }
          ],
          "properties": {
            "status": "exception",
            "criticalPath": "/exception"
          }
        }
      ]
    }
  ]
}
